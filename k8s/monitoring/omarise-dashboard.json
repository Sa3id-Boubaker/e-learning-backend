{
  "uid": "omarise-overview",
  "title": "OMARISE - Overview",
  "description": "Phase 7.3 initial OMARISE dashboard. Panels use only metrics verified live in Prometheus/Grafana Explore during Phase 7.2/7.3 (no invented metric names). Covers all 7 OMARISE services via the $app variable.",
  "tags": ["omarise", "phase-7.3"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "hide": 0,
        "current": {},
        "refresh": 1
      },
      {
        "name": "app",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": { "query": "label_values(up{namespace=\"omarise\"}, app)", "refId": "app-variable" },
        "multi": true,
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Service Availability (up)",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "up{namespace=\"omarise\", app=~\"$app\"}",
          "legendFormat": "{{app}}",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "value_and_name", "colorMode": "background" }
    },
    {
      "id": 2,
      "title": "JVM Memory Used",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{app=~\"$app\"}) by (app)",
          "legendFormat": "{{app}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "id": 3,
      "title": "JVM Uptime",
      "type": "stat",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "process_uptime_seconds{app=~\"$app\"}",
          "legendFormat": "{{app}}",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "value_and_name" }
    },
    {
      "id": 4,
      "title": "HTTP Request Rate (by method)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{app=~\"$app\"}[5m])) by (app, method)",
          "legendFormat": "{{app}} - {{method}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 5,
      "title": "HTTP Request Latency (average)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Average latency = rate(sum)/rate(count). No percentile/quantile panel: http_server_requests_seconds_bucket does not exist in this deployment (percentiles-histogram not enabled in application config, which Phase 7.3 does not permit changing).",
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_sum{app=~\"$app\"}[5m])) by (app) / sum(rate(http_server_requests_seconds_count{app=~\"$app\"}[5m])) by (app)",
          "legendFormat": "{{app}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 6,
      "title": "HTTP Non-Success Response Rate (by outcome/status)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 20, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{app=~\"$app\", outcome!=\"SUCCESS\"}[5m])) by (app, outcome, status)",
          "legendFormat": "{{app}} - {{outcome}} ({{status}})",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    }
  ]
}
